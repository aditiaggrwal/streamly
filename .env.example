# Free TMDB API key: https://www.themoviedb.org/settings/api
# Copy this file to .env for local development.
# Vite inlines this at build time, so the key is public in the JS bundle.
# That is expected for TMDB's public API key — still never commit a real key.
#
# GitHub Pages: add a repository secret with this same name.
VITE_TMDB_API_KEY=
