# Free TMDB API key: https://www.themoviedb.org/settings/api
# Copy this file to .env for local development.
# Vite inlines this at build time, so the key is public in the JS bundle.
# That is expected for TMDB's public API key — still never commit a real key.
#
# GitHub Pages: add a repository secret with this same name.
VITE_TMDB_API_KEY=

# Firebase (Auth + Firestore). Copy values from Project settings → Your apps.
# Leave blank to keep guest-only localStorage (no Sign in button).
# Add authorized domains: localhost and aditiaggrwal.github.io
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
